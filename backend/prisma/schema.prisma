generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                       Int                              @id @default(autoincrement())
  name                     String
  email                    String                           @unique
  password                 String
  role                     String // super_admin, admin_imobiliaria, diretor, gerente, corretor
  imobiliariaId            Int?
  imobiliaria              Imobiliaria?                     @relation("ImobiliariaUsers", fields: [imobiliariaId], references: [id])
  diretorId                Int? // Se for gerente, aponta para o diretor
  diretor                  User?                            @relation("DiretorGerentes", fields: [diretorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gerentes                 User[]                           @relation("DiretorGerentes")
  gerenteId                Int? // Se for corretor, aponta para o gerente
  gerente                  User?                            @relation("GerenteCorretores", fields: [gerenteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  corretores               User[]                           @relation("GerenteCorretores")
  leadsAsCorretor          Lead[]                           @relation("LeadCorretor")
  atendimentos             Atendimento[]
  propostas                Proposta[]
  visitas                  Visita[]                         @relation("AtendenteVisitas")
  dispensacoes             DispensacaoMaterial[]            @relation("DispensadoPor")
  tasks                    Task[]                           @relation("UserTasks")
  notifications            Notification[]                   @relation("UserNotifications")
  conversations            Conversation[]                   @relation("ConversationAssigned")
  comissoes                Comissao[]                       @relation("UserComissoes")
  auditLogs                AuditLog[]                       @relation("UserAuditLogs")
  accessRules              UserAccess[]
  reservasCriadas          ReservaUnidade[]                 @relation("ReservaCriadaPor")
  historicosUnidade        UnidadeStatusHistorico[]         @relation("UnidadeAlteradaPor")
  propostasAprovadas       Proposta[]                       @relation("PropostaAprovadaPor")
  atualizacoesPrecoCriadas AtualizacaoPreco[]               @relation("AtualizacaoPrecoCriadaPor")
  compartilhamentosCriados CompartilhamentoEmpreendimento[] @relation("CompartilhamentoCriadoPor")
  isApproved               Boolean                          @default(false)
  approvedAt               DateTime?
  approvedById             Int?
  lastSeenAt               DateTime?
  managedImobiliarias      ImobiliariaAdmin[]
  ownedImobiliarias        Imobiliaria[]                    @relation("ImobiliariaOwner")
  createdAt                DateTime                         @default(now())
}

model Imobiliaria {
  id                        Int                    @id @default(autoincrement())
  nome                      String
  cnpj                      String
  email                     String
  telefone                  String
  status                    String // ativa, inativa, aguardando_aprovacao
  plan                      String // basic, pro, enterprise
  comissaoPercent           Float                  @default(5.0) // % de comissão padrão desta imobiliária
  usuarios                  User[]                 @relation("ImobiliariaUsers")
  imoveis                   Imovel[]
  leads                     Lead[]
  empreendimentos           Empreendimento[]
  propostas                 Proposta[]             @relation("ImobiliariaPropostas")
  visitas                   Visita[]
  pipelineStages            PipelineStage[]
  tasks                     Task[]
  notifications             Notification[]
  config                    ConfigImobiliaria?
  empreendimentosVinculados EmpreendimentoEquipe[]
  conversations             Conversation[]
  templates                 MessageTemplate[]
  comissoes                 Comissao[]
  automations               Automation[]
  auditLogs                 AuditLog[]
  webhooks                  Webhook[]
  ownerId                   Int?
  owner                     User?                  @relation("ImobiliariaOwner", fields: [ownerId], references: [id])
  admins                    ImobiliariaAdmin[]
  planId                    Int?
  plano                     Plan?                  @relation(fields: [planId], references: [id])
  createdAt                 DateTime               @default(now())
}

model Plan {
  id              Int           @id @default(autoincrement())
  code            String        @unique
  name            String
  maxUsers        Int
  maxImobiliarias Int           @default(1)
  active          Boolean       @default(true)
  imobiliarias    Imobiliaria[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model ImobiliariaAdmin {
  id            Int         @id @default(autoincrement())
  userId        Int
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  imobiliariaId Int
  imobiliaria   Imobiliaria @relation(fields: [imobiliariaId], references: [id], onDelete: Cascade)
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())

  @@unique([userId, imobiliariaId])
  @@index([imobiliariaId])
}

model Permissao {
  id            Int      @id @default(autoincrement())
  role          String // diretor, gerente, corretor
  recurso       String // empreendimentos, propostas, leads, relatorios
  acao          String // criar, ler, atualizar, deletar
  permitido     Boolean  @default(true)
  imobiliariaId Int? // null = default global, ou específico por imobiliária
  createdAt     DateTime @default(now())

  @@unique([role, recurso, acao, imobiliariaId])
}

// Acesso individual configurado no perfil do usuário. A regra individual
// prevalece sobre as permissões padrão do cargo.
model UserAccess {
  id      Int     @id @default(autoincrement())
  userId  Int
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  page    String
  canView Boolean @default(false)
  canEdit Boolean @default(false)

  @@unique([userId, page])
  @@index([userId])
}

model Imovel {
  id            Int         @id @default(autoincrement())
  titulo        String
  descricao     String      @db.Text
  valor         Float
  endereco      String
  cidade        String
  estado        String
  status        String
  imobiliariaId Int
  imobiliaria   Imobiliaria @relation(fields: [imobiliariaId], references: [id])
  createdAt     DateTime    @default(now())
}

model Lead {
  id            Int            @id @default(autoincrement())
  nome          String
  email         String?
  telefone      String
  status        String
  origem        String
  temperatura   String?        @default("morno") // quente, morno, frio
  corretorId    Int?
  corretor      User?          @relation("LeadCorretor", fields: [corretorId], references: [id])
  imobiliariaId Int
  imobiliaria   Imobiliaria    @relation(fields: [imobiliariaId], references: [id])
  atendimentos  Atendimento[]
  pipeline      LeadPipeline?
  tasks         Task[]         @relation("LeadTasks")
  conversations Conversation[]
  clientes      Cliente[]      @relation("LeadClientes")
  createdAt     DateTime       @default(now())
}

model Atendimento {
  id         Int      @id @default(autoincrement())
  leadId     Int
  lead       Lead     @relation(fields: [leadId], references: [id])
  corretorId Int?
  corretor   User?    @relation(fields: [corretorId], references: [id])
  mensagem   String   @db.Text
  createdAt  DateTime @default(now())
}

model Empreendimento {
  id                     Int                              @id @default(autoincrement())
  nome                   String
  tipoUnidade            String // lote, casa, apartamento
  quantidadeUnidades     Int
  imagemUrl              String?                          @db.LongText
  blocosCount            Int?
  andaresPorBloco        Int?
  apartamentosPorAndar   Int?
  bairro                 String
  cidade                 String
  estado                 String
  endereco               String? // Endereço completo (rua, número)
  latitude               Float? // Geolocalização
  longitude              Float? // Geolocalização
  dataLancamento         DateTime?
  dataPrevisaoConstrucao DateTime?
  descricao              String?                          @db.Text
  status                 String                           @default("planejamento")
  destaque               Boolean                          @default(false)
  videoUrl               String?
  quartosMin             Int?
  quartosMax             Int?
  suitesMin              Int?
  suitesMax              Int?
  vagasMin               Int?
  vagasMax               Int?
  areaMin                Float?
  areaMax                Float?
  contatoGerente1        String?
  nomeGerente1           String?
  contatoGerente2        String?
  nomeGerente2           String?
  contatoGerente3        String?
  nomeGerente3           String?
  contatoGerente4        String?
  nomeGerente4           String?
  contatoGerente5        String?
  nomeGerente5           String?
  imobiliariaId          Int
  imobiliaria            Imobiliaria                      @relation(fields: [imobiliariaId], references: [id])
  unidades               Unidade[]
  propostas              Proposta[]
  visitas                Visita[]
  materiaisMarketing     MaterialMarketing[]
  galeria                GaleriaImagem[]
  equipes                EmpreendimentoEquipe[]
  tabelasPreco           TabelaPreco[]
  documentos             DocumentoEmpreendimento[]
  compartilhamentos      CompartilhamentoEmpreendimento[]
  parametrosAnalise      ParametrosAnalise?
  atualizacoesPreco      AtualizacaoPreco[]
  createdAt              DateTime                         @default(now())
}

model Unidade {
  id               Int                      @id @default(autoincrement())
  empreendimentoId Int
  empreendimento   Empreendimento           @relation(fields: [empreendimentoId], references: [id], onDelete: Cascade)
  numero           String // número do lote/casa/apartamento
  valorBase        Float
  juros            Float                    @default(0)
  valorTotal       Float // valorBase + juros (calculado)
  status           String                   @default("disponivel") // disponivel, reservada, em_aprovacao, em_negociacao, venda_suspensa, vendido, permuta, alugada, fora_de_venda, pre_reservada
  bloco            String?
  identificacao    String?
  tipo             String?
  area             Float?
  andar            Int?
  quartos          Int?
  suites           Int?
  vagas            Int?
  propostas        Proposta[]
  visitas          Visita[]
  reservas         ReservaUnidade[]
  historicoStatus  UnidadeStatusHistorico[]
  createdAt        DateTime                 @default(now())
}

model DocumentoEmpreendimento {
  id               Int            @id @default(autoincrement())
  empreendimentoId Int
  empreendimento   Empreendimento @relation(fields: [empreendimentoId], references: [id], onDelete: Cascade)
  nome             String
  tipo             String         @default("outro")
  url              String         @db.LongText
  publico          Boolean        @default(false)
  createdAt        DateTime       @default(now())

  @@index([empreendimentoId])
}

model CompartilhamentoEmpreendimento {
  id               Int            @id @default(autoincrement())
  token            String         @unique
  empreendimentoId Int
  empreendimento   Empreendimento @relation(fields: [empreendimentoId], references: [id], onDelete: Cascade)
  createdById      Int
  createdBy        User           @relation("CompartilhamentoCriadoPor", fields: [createdById], references: [id])
  clienteNome      String?
  clienteEmail     String?
  permitirPrecos   Boolean        @default(false)
  permitirUnidades Boolean        @default(true)
  ativo            Boolean        @default(true)
  expiresAt        DateTime?
  visualizacoes    Int            @default(0)
  lastViewedAt     DateTime?
  createdAt        DateTime       @default(now())

  @@index([empreendimentoId, ativo])
}

model ReservaUnidade {
  id                 Int       @id @default(autoincrement())
  unidadeId          Int
  unidade            Unidade   @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  createdById        Int
  createdBy          User      @relation("ReservaCriadaPor", fields: [createdById], references: [id])
  clienteNome        String
  clienteCpf         String?
  status             String    @default("ativa")
  expiresAt          DateTime
  cancelledAt        DateTime?
  motivoCancelamento String?
  createdAt          DateTime  @default(now())

  @@index([unidadeId, status, expiresAt])
}

model UnidadeStatusHistorico {
  id             Int      @id @default(autoincrement())
  unidadeId      Int
  unidade        Unidade  @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  statusAnterior String
  statusNovo     String
  changedById    Int?
  changedBy      User?    @relation("UnidadeAlteradaPor", fields: [changedById], references: [id], onDelete: SetNull)
  motivo         String?
  createdAt      DateTime @default(now())

  @@index([unidadeId, createdAt])
}

model Proposta {
  id               Int            @id @default(autoincrement())
  empreendimentoId Int
  empreendimento   Empreendimento @relation(fields: [empreendimentoId], references: [id])
  unidadeId        Int
  unidade          Unidade        @relation(fields: [unidadeId], references: [id])
  corretorId       Int
  corretor         User           @relation(fields: [corretorId], references: [id])
  imobiliariaId    Int?
  imobiliaria      Imobiliaria?   @relation("ImobiliariaPropostas", fields: [imobiliariaId], references: [id])
  tabelaId         Int?
  tabela           TabelaPreco?   @relation(fields: [tabelaId], references: [id])

  // Dados do cliente
  clienteNome        String
  clienteSobrenome   String  @default("")
  clienteRg          String  @default("")
  clienteCpf         String  @default("")
  clienteProfissao   String  @default("")
  clienteRemuneracao Float   @default(0)

  // Forma de pagamento (legado / resumo rápido)
  valorAVista     Float?
  valor30Dias     Float?
  valor60Dias     Float?
  valor90Dias     Float?
  valorMensais    Float?
  valorSemestrais Float?
  valorAnuais     Float?
  valorUnico      Float?
  saldoFinanciar  Float?

  // Simulação / análise de proposta
  tipoAnalise      String          @default("simulacao") // simulacao | proposta
  valorTabela      Float? // total da tabela de venda para a unidade
  valorProposta    Float? // total proposto pelo cliente
  descontoAplicado Float           @default(0) // desconto em R$ concedido na unidade
  diferenca        Float? // valorProposta - (valorTabela - descontoAplicado)
  resultadoAnalise Json? // snapshot dos critérios calculados
  indicadores      Json? // snapshot dos indicadores complementares
  requerAprovacao  Boolean         @default(false)
  aprovadoPorId    Int?
  aprovadoPor      User?           @relation("PropostaAprovadaPor", fields: [aprovadoPorId], references: [id], onDelete: SetNull)
  aprovadoEm       DateTime?
  motivoReprovacao String?         @db.Text
  series           PropostaSerie[]

  status      String      @default("rascunho") // rascunho | simulacao | em_analise | aprovada | reprovada | cancelada | pendente
  observacoes String?     @db.Text
  comissoes   Comissao[]
  cliente     Cliente?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt
}

// Cadastro completo do cliente, preenchido depois que a proposta é aprovada.
model Cliente {
  id                 Int      @id @default(autoincrement())
  propostaId         Int      @unique
  proposta           Proposta @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  leadId             Int?
  lead               Lead?    @relation("LeadClientes", fields: [leadId], references: [id], onDelete: SetNull)

  nome               String
  sobrenome          String?
  cpf                String
  rg                 String?
  orgaoExpedidor     String?
  dataNascimento     DateTime?
  nacionalidade      String?  @default("Brasileira")
  estadoCivil        String? // solteiro | casado | uniao_estavel | divorciado | viuvo
  profissao          String?
  rendaMensal        Float?
  email              String?
  telefone           String?

  // Endereço
  cep                String?
  logradouro         String?
  numero             String?
  complemento        String?
  bairro             String?
  cidade             String?
  estado             String?

  // Cônjuge / co-participante
  conjugeNome        String?
  conjugeCpf         String?
  conjugeRg          String?
  conjugeProfissao   String?
  conjugeRendaMensal Float?

  observacoes        String?  @db.Text
  concluido          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  @@index([leadId])
}

// Linha da "proposta do cliente" — espelha as séries da tabela e é editável.
model PropostaSerie {
  id            Int      @id @default(autoincrement())
  propostaId    Int
  proposta      Proposta @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  nome          String
  tipo          String
  inicioMes     Int
  inicioAno     Int
  quantidade    Int      @default(1)
  valor         Float
  periodicidade Int      @default(1)
  aposHabitese  Boolean  @default(false)
  vencimentoDia Int?
  total         Float    @default(0)
  ordem         Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([propostaId])
}

// Parâmetros de análise de proposta, configurados por empreendimento.
model ParametrosAnalise {
  id                     Int            @id @default(autoincrement())
  empreendimentoId       Int            @unique
  empreendimento         Empreendimento @relation(fields: [empreendimentoId], references: [id], onDelete: Cascade)
  prazoFinanciamentoMax  Int? // meses
  captacaoAvistaMin      Float? // %
  captacaoAteHabiteseMin Float? // %
  captacaoMensalMin      Float? // %
  diferencaAvMax         Float? // % de diferença tolerada no valor à vista
  descontoNominalMax     Float? // % de desconto nominal máximo
  exigirIntercalacao     Boolean        @default(false)
  taxaAtratividade       Float? // % a.m. usada no valor presente / equivalência de fluxo
  toleranciaGeral        Float          @default(0) // % de tolerância aplicada aos limites
  toleranciasJson        Json? // tolerância fina por critério (opcional)
  formasPagamento        Json? // tipos de série aceitos na proposta (vazio/null = todos)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @default(now()) @updatedAt
}

// Job de atualização de preço das unidades de um empreendimento.
model AtualizacaoPreco {
  id               Int            @id @default(autoincrement())
  empreendimentoId Int
  empreendimento   Empreendimento @relation(fields: [empreendimentoId], references: [id], onDelete: Cascade)
  titulo           String
  justificativa    String?        @db.Text
  metodo           String // manter | percentual | valor_fixo
  valorParametro   Float? // % ou R$ conforme o método
  alvo             String         @default("valorBase") // valorBase | valorTotal
  executarEm       DateTime? // null = executa imediatamente
  situacao         String         @default("agendada") // agendada | processando | concluida | cancelada | erro
  qtdUnidades      Int            @default(0)
  criadoPorId      Int
  criadoPor        User           @relation("AtualizacaoPrecoCriadaPor", fields: [criadoPorId], references: [id])
  executadaEm      DateTime?
  erroMensagem     String?        @db.Text
  snapshotJson     Json? // preços anteriores para permitir desfazer
  createdAt        DateTime       @default(now())

  @@index([situacao, executarEm])
  @@index([empreendimentoId, createdAt])
}

model Visita {
  id                Int            @id @default(autoincrement())
  nomeVisitante     String
  telefoneVisitante String
  emailVisitante    String?
  tipo              String // agendada, espontanea
  dataVisita        DateTime       @default(now())
  empreendimentoId  Int
  empreendimento    Empreendimento @relation(fields: [empreendimentoId], references: [id])
  unidadeId         Int?
  unidade           Unidade?       @relation(fields: [unidadeId], references: [id])
  imobiliariaId     Int?
  imobiliaria       Imobiliaria?   @relation(fields: [imobiliariaId], references: [id])
  atendenteId       Int
  atendente         User           @relation("AtendenteVisitas", fields: [atendenteId], references: [id])
  observacoes       String?        @db.Text
  createdAt         DateTime       @default(now())
}

model MaterialMarketing {
  id                Int                   @id @default(autoincrement())
  tipo              String // banner, folder
  empreendimentoId  Int
  empreendimento    Empreendimento        @relation(fields: [empreendimentoId], references: [id])
  quantidadeInicial Int
  quantidadeEstoque Int
  descricao         String?               @db.Text
  dispensacoes      DispensacaoMaterial[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
}

model DispensacaoMaterial {
  id                Int               @id @default(autoincrement())
  materialId        Int
  material          MaterialMarketing @relation(fields: [materialId], references: [id], onDelete: Cascade)
  quantidade        Int
  dispensadoPara    String
  dispensadoPor     Int
  dispensadoPorUser User              @relation("DispensadoPor", fields: [dispensadoPor], references: [id])
  dataDispensacao   DateTime          @default(now())
  observacoes       String?           @db.Text
}

// ===== PIPELINE CRM =====

model PipelineStage {
  id            Int            @id @default(autoincrement())
  nome          String
  ordem         Int
  cor           String         @default("#3b82f6")
  imobiliariaId Int
  imobiliaria   Imobiliaria    @relation(fields: [imobiliariaId], references: [id])
  leads         LeadPipeline[]
  createdAt     DateTime       @default(now())

  @@unique([imobiliariaId, ordem])
}

model LeadPipeline {
  id             Int           @id @default(autoincrement())
  leadId         Int           @unique
  lead           Lead          @relation(fields: [leadId], references: [id])
  stageId        Int
  stage          PipelineStage @relation(fields: [stageId], references: [id])
  temperatura    String        @default("morno") // quente, morno, frio
  valorPotencial Float?
  enteredStageAt DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// ===== TAREFAS =====

model Task {
  id            Int         @id @default(autoincrement())
  titulo        String
  descricao     String?     @db.Text
  tipo          String // follow_up, ligacao, visita, documentacao, outro
  prioridade    String      @default("media") // baixa, media, alta
  status        String      @default("pendente") // pendente, concluida, atrasada
  prazo         DateTime
  concluidaEm   DateTime?
  userId        Int
  user          User        @relation("UserTasks", fields: [userId], references: [id])
  leadId        Int?
  lead          Lead?       @relation("LeadTasks", fields: [leadId], references: [id])
  imobiliariaId Int
  imobiliaria   Imobiliaria @relation(fields: [imobiliariaId], references: [id])
  createdAt     DateTime    @default(now())
}

// ===== NOTIFICAÇÕES =====

model Notification {
  id            Int         @id @default(autoincrement())
  userId        Int
  user          User        @relation("UserNotifications", fields: [userId], references: [id])
  tipo          String // nova_mensagem, nova_proposta, proposta_aprovada, lead_atribuido, lembrete_tarefa
  titulo        String
  mensagem      String
  lida          Boolean     @default(false)
  link          String? // URL de destino ao clicar
  imobiliariaId Int
  imobiliaria   Imobiliaria @relation(fields: [imobiliariaId], references: [id])
  createdAt     DateTime    @default(now())

  @@index([userId, lida])
}

// ===== CONFIGURAÇÕES DA IMOBILIÁRIA =====

model ConfigImobiliaria {
  id               Int         @id @default(autoincrement())
  imobiliariaId    Int         @unique
  imobiliaria      Imobiliaria @relation(fields: [imobiliariaId], references: [id])
  logoUrl          String?
  corPrimaria      String      @default("#6366f1")
  corSecundaria    String      @default("#8b5cf6")
  tema             String      @default("dark") // dark, light
  horarioInicio    String      @default("08:00")
  horarioFim       String      @default("18:00")
  comissaoCorretor Float       @default(3.0)
  comissaoGerente  Float       @default(1.0)
  comissaoDiretor  Float       @default(0.5)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

// ===== GALERIA DE IMAGENS DO EMPREENDIMENTO =====

model GaleriaImagem {
  id               Int            @id @default(autoincrement())
  empreendimentoId Int
  empreendimento   Empreendimento @relation(fields: [empreendimentoId], references: [id], onDelete: Cascade)
  url              String         @db.LongText
  categoria        String // fachada, areas_comuns, decorados, plantas, outros
  titulo           String?
  isCapa           Boolean        @default(false)
  ordem            Int            @default(0)
  createdAt        DateTime       @default(now())
}

// ===== VINCULAÇÃO EQUIPE (IMOBILIÁRIA) ↔ EMPREENDIMENTO =====

model EmpreendimentoEquipe {
  id               Int            @id @default(autoincrement())
  empreendimentoId Int
  empreendimento   Empreendimento @relation(fields: [empreendimentoId], references: [id], onDelete: Cascade)
  imobiliariaId    Int
  imobiliaria      Imobiliaria    @relation(fields: [imobiliariaId], references: [id])
  comissaoPercent  Float          @default(5.0) // % de comissão específica para esta equipe neste empreendimento
  ativa            Boolean        @default(true)
  createdAt        DateTime       @default(now())

  @@unique([empreendimentoId, imobiliariaId])
}

// ===== TABELA DE PREÇOS (NCC) =====

model TabelaPreco {
  id               Int                @id @default(autoincrement())
  empreendimentoId Int
  empreendimento   Empreendimento     @relation(fields: [empreendimentoId], references: [id], onDelete: Cascade)
  nome             String // Ex: "Tabela Padrão", "Tabela Promocional", "NCC Julho 2026"
  grupo            String             @default("padrao") // padrao, promocional, especial
  modelo           String             @default("modelo_1") // modelo_1 a modelo_5, flex_01, flex_02
  ativa            Boolean            @default(true)
  incluirDesconto  Boolean            @default(false)
  incluirJuros     Boolean            @default(false)
  validadeInicio   DateTime? // Período de validade da tabela de venda
  validadeFim      DateTime?
  tipologia        String? // Se a tabela é específica de uma tipologia/planta (null = todas)
  series           TabelaPrecoSerie[]
  propostas        Proposta[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

// Série de pagamento da tabela de venda (estilo Anapro): Ato, 30dd, 60dd,
// Mensais, Semestrais, Única, Financiamento.
model TabelaPrecoSerie {
  id              Int         @id @default(autoincrement())
  tabelaId        Int
  tabela          TabelaPreco @relation(fields: [tabelaId], references: [id], onDelete: Cascade)
  unidadeId       Int? // Override por unidade específica (null = vale para toda a tabela)
  nome            String // "Ato", "30dd", "Mensais", "Semestrais", "Única", "Financiamento"
  tipo            String // ato | pontual | mensal | semestral | anual | unica | financiamento
  inicioMes       Int // 1-12
  inicioAno       Int
  valor           Float // valor unitário da parcela
  quantidade      Int         @default(1)
  periodicidade   Int         @default(1) // meses entre parcelas
  aposHabitese    Boolean     @default(false)
  percentualTotal Float? // % do valor total (calculado no backend)
  observacao      String?     @db.Text
  ordem           Int         @default(0)
  createdAt       DateTime    @default(now())

  @@index([tabelaId])
}

// ===== INBOX / CONVERSAS =====

model Conversation {
  id            Int         @id @default(autoincrement())
  canal         String // whatsapp, instagram, facebook, email, chat
  status        String      @default("aberta") // aberta, pendente, resolvida
  externalId    String? // ID externo (WhatsApp message ID, etc)
  contactName   String
  contactPhone  String?
  contactEmail  String?
  leadId        Int?
  lead          Lead?       @relation(fields: [leadId], references: [id])
  assignedToId  Int?
  assignedTo    User?       @relation("ConversationAssigned", fields: [assignedToId], references: [id])
  imobiliariaId Int
  imobiliaria   Imobiliaria @relation(fields: [imobiliariaId], references: [id])
  messages      Message[]
  lastMessageAt DateTime    @default(now())
  createdAt     DateTime    @default(now())

  @@index([imobiliariaId, status])
  @@index([imobiliariaId, canal])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String // inbound, outbound
  content        String       @db.Text
  contentType    String       @default("text") // text, image, audio, document
  mediaUrl       String?
  status         String       @default("sent") // sent, delivered, read, failed
  senderName     String?
  isAI           Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

// ===== TEMPLATES DE MENSAGENS =====

model MessageTemplate {
  id            Int         @id @default(autoincrement())
  nome          String
  categoria     String // boas_vindas, follow_up, agendamento, proposta, documentacao
  conteudo      String      @db.Text // Com variáveis {{nome_lead}}, {{empreendimento}}, etc
  canal         String      @default("todos") // whatsapp, email, todos
  imobiliariaId Int
  imobiliaria   Imobiliaria @relation(fields: [imobiliariaId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ===== COMISSÕES =====

model Comissao {
  id            Int         @id @default(autoincrement())
  propostaId    Int
  proposta      Proposta    @relation(fields: [propostaId], references: [id])
  userId        Int
  user          User        @relation("UserComissoes", fields: [userId], references: [id])
  role          String // role do usuário no momento do cálculo
  percentual    Float // % da comissão
  valorVenda    Float // valor total da venda
  valorComissao Float // valor calculado
  status        String      @default("pendente") // pendente, paga
  dataPagamento DateTime?
  imobiliariaId Int
  imobiliaria   Imobiliaria @relation(fields: [imobiliariaId], references: [id])
  createdAt     DateTime    @default(now())
}

// ===== AUTOMAÇÕES =====

model Automation {
  id            Int              @id @default(autoincrement())
  nome          String
  descricao     String?
  status        String           @default("rascunho") // rascunho, ativo, inativo
  gatilho       String // novo_lead, lead_mudou_estagio, mensagem_recebida, tempo, proposta_criada
  nodes         Json // Array de nós do fluxo
  edges         Json // Array de conexões entre nós
  imobiliariaId Int
  imobiliaria   Imobiliaria      @relation(fields: [imobiliariaId], references: [id])
  executions    AutomationExec[]
  lastRunAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model AutomationExec {
  id           Int        @id @default(autoincrement())
  automationId Int
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  leadId       Int?
  status       String // running, success, failed
  logs         Json?
  startedAt    DateTime   @default(now())
  completedAt  DateTime?
}

// ===== AUDITORIA =====

model AuditLog {
  id            Int          @id @default(autoincrement())
  userId        Int
  user          User         @relation("UserAuditLogs", fields: [userId], references: [id])
  acao          String // login, criar, editar, deletar, aprovar, rejeitar
  recurso       String // lead, proposta, empreendimento, usuario, permissao, unidade
  recursoId     Int?
  detalhes      Json?
  ip            String?
  imobiliariaId Int?
  imobiliaria   Imobiliaria? @relation(fields: [imobiliariaId], references: [id])
  createdAt     DateTime     @default(now())

  @@index([imobiliariaId, createdAt])
  @@index([userId, createdAt])
}

// ===== WEBHOOKS CONFIGURÁVEIS =====

model Webhook {
  id            Int               @id @default(autoincrement())
  url           String
  eventos       Json // Array de eventos assinados
  secretKey     String
  ativo         Boolean           @default(true)
  imobiliariaId Int
  imobiliaria   Imobiliaria       @relation(fields: [imobiliariaId], references: [id])
  deliveries    WebhookDelivery[]
  createdAt     DateTime          @default(now())
}

model WebhookDelivery {
  id         Int      @id @default(autoincrement())
  webhookId  Int
  webhook    Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  evento     String
  payload    Json
  statusCode Int?
  response   String?  @db.Text
  sucesso    Boolean
  createdAt  DateTime @default(now())
}

// ===== AUDITORIA =====
