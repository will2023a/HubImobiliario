# ===== Gestor Pro 360 - Backend Environment =====

# Database (MySQL)
DATABASE_URL="mysql://root:root@mysql:3306/crm_imobiliario"
# Para uso local sem Docker:
# DATABASE_URL="mysql://root:root@localhost:3306/crm_imobiliario"

# Auth
JWT_SECRET=super_secret_jwt_key_change_me_in_production

# Server
NODE_ENV=development
PORT=3000

# Frontend URL (CORS + Socket.io)
FRONTEND_URL=http://localhost:1234

# Redis (para WebSocket adapter e filas)
REDIS_URL=redis://redis:6379
# Para uso local sem Docker:
# REDIS_URL=redis://localhost:6379

# MinIO / S3 (armazenamento de arquivos)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=gestorpro360
# Para uso local sem Docker:
# MINIO_ENDPOINT=localhost

# IA (futuro)
# OPENAI_API_KEY=sk-...
# CLAUDE_API_KEY=sk-ant-...

# WhatsApp - Evolution API (futuro)
# EVOLUTION_API_URL=http://evolution-api:8080
# EVOLUTION_API_KEY=...
